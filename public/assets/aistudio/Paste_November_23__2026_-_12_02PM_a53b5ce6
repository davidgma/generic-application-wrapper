================================================================================
3. Drop-In Client Helper (JavaScript / TypeScript v1.6)
================================================================================
const H2_SESSION_STORAGE_KEY = "h2_bridge_session_id";

export function uint8ToBase64(bytes) {
  let binary = "";
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) {
    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
  }
  return btoa(binary);
}

export function base64ToUint8(b64) {
  const bin = atob(b64 || "");
  const out = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
  return out;
}

export class H2BridgeClient {
  constructor(clientName = "External Web App", storageKey = H2_SESSION_STORAGE_KEY) {
    this.clientName = clientName;
    this.storageKey = storageKey;
    this.sessionId = null;
    this.pending = new Map();
    this.sessionInfo = null;
    this._reconnectPromise = null;
    this.onReady = null;
    this._fileListeners = new Set();
    this._folderListeners = new Set();
    this._onMsg = (event) => {
      if (event.source !== window) return;
      const d = event.data;
      if (!d || d.protocol !== "H2_CLOUD_BRIDGE" || !d.__h2FromExtension) return;
      if (d.type === "H2_BRIDGE_READY") {
        if (typeof this.onReady === "function") this.onReady(d);
        return;
      }
      if (d.type === "H2_FILE_CHANGED_EVENT") {
        if (this.sessionId && d.sessionId && d.sessionId !== this.sessionId) return;
        this._fileListeners.forEach((fn) => { try { fn(d); } catch {} });
        return;
      }
      if (d.type === "H2_FOLDER_CHANGED_EVENT") {
        if (this.sessionId && d.sessionId && d.sessionId !== this.sessionId) return;
        this._folderListeners.forEach((fn) => { try { fn(d); } catch {} });
        return;
      }
      const entry = this.pending.get(d.requestId);
      if (entry) {
        if (this.sessionId && d.sessionId && d.sessionId !== this.sessionId) return;
        this.pending.delete(d.requestId);
        if (d.success) {
          if (d.sessionId) {
            this.sessionId = d.sessionId;
            try { window.sessionStorage.setItem(this.storageKey, d.sessionId); } catch {}
          }
          entry.resolve(d);
        } else {
          const err = new Error(d.error || "Bridge request failed");
          err.reasonCode = d.reasonCode || null;
          if (d.currentRevision !== undefined) err.currentRevision = d.currentRevision;
          if (d.exists !== undefined) err.exists = d.exists;
          if (d.modifiedMs !== undefined) err.modifiedMs = d.modifiedMs;
          if (d.sizeBytes !== undefined) err.sizeBytes = d.sizeBytes;
          if (d.maxPayloadBytes !== undefined) err.maxPayloadBytes = d.maxPayloadBytes;
          entry.reject(err);
        }
      }
    };
    window.addEventListener("message", this._onMsg);
  }
  static async connect(clientName = "External Web App", storageKey = H2_SESSION_STORAGE_KEY) {
    const client = new H2BridgeClient(clientName, storageKey);
    await client.reconnect();
    return client;
  }
  async reconnect() {
    if (this._reconnectPromise) return this._reconnectPromise;
    this._reconnectPromise = (async () => {
      let previousSessionId = this.sessionId;
      try {
        if (!previousSessionId) previousSessionId = window.sessionStorage.getItem(this.storageKey);
        window.sessionStorage.removeItem(this.storageKey);
      } catch {}
      this.sessionId = null;
      this.sessionInfo = await this._sendOnce("H2_CONNECT_REQ", {
        clientName: this.clientName,
        previousSessionId: previousSessionId || undefined,
        supportedVersions: ["1.6"]
      }, 15000);
      return this.sessionInfo;
    })().finally(() => { this._reconnectPromise = null; });
    return this._reconnectPromise;
  }
  onFileChanged(handler) {
    this._fileListeners.add(handler);
    return () => this._fileListeners.delete(handler);
  }
  onFolderChanged(handler) {
    this._folderListeners.add(handler);
    return () => this._folderListeners.delete(handler);
  }
  _post(type, payload = {}, explicitReqId) {
    const requestId = explicitReqId || (type + "_" + Date.now() + "_" + Math.random().toString(36).slice(2, 7));
    window.postMessage({ protocol: "H2_CLOUD_BRIDGE", protocolVersion: "1.6", sessionId: this.sessionId, requestId, type, ...payload }, window.location.origin);
    return requestId;
  }
  _sendOnce(type, payload = {}, timeoutMs = 60000) {
    return new Promise((resolve, reject) => {
      const requestId = this._post(type, payload);
      const timer = setTimeout(() => { this.pending.delete(requestId); reject(new Error(type + " timed out")); }, timeoutMs);
      this.pending.set(requestId, {
        resolve: (d) => { clearTimeout(timer); resolve(d); },
        reject: (e) => { clearTimeout(timer); reject(e); }
      });
    });
  }
  async request(type, payload = {}, timeoutMs = 60000) {
    try {
      return await this._sendOnce(type, payload, timeoutMs);
    } catch (err) {
      // Automatically reconnect once on SESSION_EXPIRED in direct mode (single-flight safe)
      if (err && err.reasonCode === "SESSION_EXPIRED" && type !== "H2_CONNECT_REQ" && type !== "H2_DISCONNECT_REQ" && (!this.sessionInfo || this.sessionInfo.sessionMode === "direct")) {
        await this.reconnect();
        return await this._sendOnce(type, payload, timeoutMs);
      }
      throw err;
    }
  }
  requestTree({ provider, driveRoot = false, basePath, baseFolderId, maxDepth } = {}) {
    return this.request("H2_WORKSPACE_TREE_REQ", { provider, driveRoot, basePath, baseFolderId, maxDepth });
  }
  switchDriveRoot(provider, maxDepth = 1) {
    return this.requestTree({ provider, driveRoot: true, maxDepth });
  }
  listFolder({ provider, driveRoot = false, basePath, baseFolderId, maxDepth = 1 } = {}) {
    return this.request("H2_LIST_FOLDER_REQ", { provider, driveRoot, basePath, baseFolderId, maxDepth });
  }
  statFile({ provider, driveRoot = false, relativePath, fileId } = {}) {
    return this.request("H2_STAT_FILE_REQ", { provider, driveRoot, relativePath, fileId });
  }
  readFile(relativePath, fileId, encoding, provider, driveRoot = false) {
    return this.request("H2_READ_FILE_REQ", { provider, driveRoot, relativePath, fileId, encoding });
  }
  async readBinaryFile({ provider, driveRoot = false, relativePath, fileId } = {}) {
    const res = await this.request("H2_READ_FILE_REQ", { provider, driveRoot, relativePath, fileId, encoding: "base64" });
    return { ...res, bytes: base64ToUint8(res.content || "") };
  }
  readFiles(items) {
    return Promise.all(items.map((it) => this.readFile(it.relativePath, it.fileId, it.encoding, it.provider, it.driveRoot)));
  }
  saveFile({ provider, driveRoot = false, relativePath, fileId, mimeType, contentType = "text", encoding = "utf-8", content, expectedRevision }) {
    return this.request("H2_SAVE_FILE_REQ", { provider, driveRoot, relativePath, fileId, mimeType, contentType, encoding, content, expectedRevision });
  }
  saveBinaryFile({ provider, driveRoot = false, relativePath, fileId, mimeType = "application/vnd.sqlite3", bytes, expectedRevision }) {
    return this.saveFile({ provider, driveRoot, relativePath, fileId, mimeType, contentType: "binary", encoding: "base64", content: uint8ToBase64(bytes), expectedRevision });
  }
  observeFile({ provider, driveRoot = false, relativePath, fileId, pollIntervalMs, debounceMs } = {}) {
    return this.request("H2_OBSERVE_FILE_REQ", { provider, driveRoot, relativePath, fileId, pollIntervalMs, debounceMs });
  }
  observeFolder({ provider, driveRoot = false, relativePath = "", folderId, recursive = false, pollIntervalMs, debounceMs } = {}) {
    return this.request("H2_OBSERVE_FOLDER_REQ", { provider, driveRoot, relativePath, folderId, recursive, pollIntervalMs, debounceMs });
  }
  unobserve(observationIdOrOptions) {
    const payload = typeof observationIdOrOptions === "string" ? { observationId: observationIdOrOptions } : (observationIdOrOptions || { all: true });
    return this.request("H2_UNOBSERVE_REQ", payload);
  }
  createFolder({ provider, driveRoot = false, relativePath, parentRelativePath, parentFolderId, folderName }) {
    return this.request("H2_CREATE_FOLDER_REQ", { provider, driveRoot, relativePath, parentRelativePath, parentFolderId, folderName });
  }
  deleteFile({ provider, driveRoot = false, relativePath, fileId, permanent = false }) {
    return this.request("H2_DELETE_FILE_REQ", { provider, driveRoot, relativePath, fileId, permanent });
  }
  deleteFolder({ provider, driveRoot = false, relativePath, folderId, permanent = false }) {
    return this.request("H2_DELETE_FOLDER_REQ", { provider, driveRoot, relativePath, folderId, permanent });
  }
  deleteItem({ provider, driveRoot = false, itemType = "file", relativePath, fileId, folderId, permanent = false }) {
    if (itemType === "folder") return this.deleteFolder({ provider, driveRoot, relativePath, folderId, permanent });
    return this.deleteFile({ provider, driveRoot, relativePath, fileId, permanent });
  }
  moveFile({ provider, targetProvider, driveRoot = false, relativePath, fileId, targetRelativePath, targetParentPath, newName, overwrite = false }) {
    return this.request("H2_MOVE_FILE_REQ", { provider, targetProvider, driveRoot, relativePath, fileId, targetRelativePath, targetParentPath, newName, overwrite });
  }
  moveFolder({ provider, targetProvider, driveRoot = false, relativePath, folderId, targetRelativePath, targetParentPath, newName, overwrite = false }) {
    return this.request("H2_MOVE_FOLDER_REQ", { provider, targetProvider, driveRoot, relativePath, folderId, targetRelativePath, targetParentPath, newName, overwrite });
  }
  async disconnect() {
    try { window.sessionStorage.removeItem(this.storageKey); } catch {}
    if (this.sessionId) {
      await this.request("H2_DISCONNECT_REQ", {}, 5000).catch(() => {});
      this.sessionId = null;
    }
    this.destroy();
  }
  destroy() {
    this._fileListeners.clear();
    this._folderListeners.clear();
    window.removeEventListener("message", this._onMsg);
  }
}